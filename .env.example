APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
APP_CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite+aiosqlite:///./data/ai_platform.db
AUTO_CREATE_TABLES=true

AI_MOCK_MODE=true
GPTSAPI_BASE_URL=https://api.gptsapi.net/v1
GPTSAPI_API_KEY=
GPTSAPI_MODEL=gpt-5.6-luna
AI_CONNECT_TIMEOUT_SECONDS=10
AI_READ_TIMEOUT_SECONDS=120
AI_STREAM_IDLE_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_DELAYS_SECONDS=1,2

# Leave empty for local development. Configure in shared environments.
INTERNAL_API_TOKEN=
AUDIT_RETENTION_DAYS=90

RECRUITMENT_MAX_UPLOAD_MB=10
RECRUITMENT_MAX_PDF_PAGES=20
RECRUITMENT_MAX_EXTRACTED_CHARS=100000
RECRUITMENT_MAX_DOCX_UNCOMPRESSED_MB=50
