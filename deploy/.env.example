COMPOSE_PROJECT_NAME=bluedot-ai-platform
APP_ENV=production
APP_CORS_ORIGINS=http://localhost:18554

MYSQL_DATABASE=ai_platform
MYSQL_USER=ai_platform
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

AI_MOCK_MODE=false
GPTSAPI_BASE_URL=https://api.gptsapi.net/v1
GPTSAPI_API_KEY=
GPTSAPI_MODEL=gpt-5.6-luna
INTERNAL_API_TOKEN=replace-with-a-long-random-token
RECRUITMENT_MAX_UPLOAD_MB=10
RECRUITMENT_MAX_PDF_PAGES=20
RECRUITMENT_MAX_EXTRACTED_CHARS=100000
RECRUITMENT_MAX_DOCX_UNCOMPRESSED_MB=50
NGINX_CLIENT_MAX_BODY_SIZE=11m

WEB_PORT=18554
